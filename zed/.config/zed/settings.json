// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  /* Duplicated key auto-commented: "agent": {
    "default_profile": "ask",
    "model_parameters": []
  }, */
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "disable_ai": true,
  "markdown_preview": {
    "max_width": 1000.0,
    "limit_content_width": false
  },
  "agent_ui_font_size": 13.1,
  "terminal": {
    "font_size": 12.0
  },
  "preview_tabs": {
    "enabled": false
  },
  "proxy": "",
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left"
  },
  "lsp": {
    "vscode-css-language-server": {
      "settings": {
        "css": {
          "lint": {
            "unknownAtRules": "ignore",
          },
        },
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "agent_buffer_font_size": 11.0,
  "diff_view_style": "split",
  "zoomed_padding": true,
  "tab_bar": {
    "show_tab_bar_buttons": true,
  },
  "ui_font_family": ".ZedSans",
  "buffer_line_height": {
    "custom": 1.5,
  },
  "buffer_font_weight": 400.0,
  "debugger": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
    "tree_view": true,
  },
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "icon_theme": {
    "mode": "system",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "agent": {
    "sidebar_side": "right",
    "play_sound_when_agent_done": "always",
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^git\\s+diff(\\s|$)",
            },
          ],
        },
      },
    },
    "favorite_models": [
      {
        "provider": "zed.dev",
        "model": "gpt-5.2",
        "enable_thinking": false,
      },
    ],
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "openai-subscribed",
      "model": "gpt-5.5",
    },
  },
  "vim_mode": true,
  "ui_font_size": 13.1,
  "buffer_font_size": 11.5,
  "theme": {
    "mode": "system",
    "light": "GitHub Light",
    "dark": "Min Dark (Solid)",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000, // Adjust this: e.g., 500 for faster, 2000 for slower
    },
  },
}
